/// Example ViewModel generated by `cargo xtask new-module`; replace it.
///
/// A ViewModel is a plain struct with state and actions, so the interaction logic is
/// testable without a UI (architecture §4.1). The views in `{{id}}-ui` only display
/// the state and call the actions.
#[derive(Debug, Clone, Default, PartialEq, Eq)]
pub struct ExampleViewModel {
    refresh_count: u32,
}

impl ExampleViewModel {
    /// Creates the ViewModel in its initial state.
    #[must_use]
    pub fn new() -> Self {
        Self::default()
    }

    /// How often [`ExampleViewModel::refresh`] has been called.
    #[must_use]
    pub fn refresh_count(&self) -> u32 {
        self.refresh_count
    }

    /// Example action: counts one refresh.
    pub fn refresh(&mut self) {
        self.refresh_count = self.refresh_count.saturating_add(1);
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn starts_without_refreshes() {
        assert_eq!(ExampleViewModel::new().refresh_count(), 0);
    }

    #[test]
    fn refresh_counts_each_call() {
        let mut view_model = ExampleViewModel::new();
        view_model.refresh();
        view_model.refresh();
        assert_eq!(view_model.refresh_count(), 2);
    }
}
