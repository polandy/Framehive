 	FILE *file = fopen(cur->fsname, "rb");
 	if (!file) {
@@ -2030,6 +2046,8 @@
 
 	/* Emulated PTP camera stuff */
 
+	if (unplugged ())
+		return GP_ERROR_IO;
 	if (toread > cam->nrinbulk)
 		toread = cam->nrinbulk;
 
@@ -2041,6 +2059,8 @@
 
