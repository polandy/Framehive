+static int
+ptp_getpartialobject_write(vcamera *cam, ptpcontainer *ptp) {
+	unsigned char 		*data;
+	struct ptp_dirent	*cur;
+	uint32_t		offset, bytes;
+
+	CHECK_SEQUENCE_NUMBER();
+	CHECK_SESSION();
+	CHECK_PARAM_COUNT(3);
+
+	cur = first_dirent;
+	while (cur) {
+		if (cur->id == ptp->params[0]) break;
+		cur = cur->next;
+	}
+	if (!cur) {
+		gp_log (GP_LOG_ERROR,__FUNCTION__, "invalid object handle 0x%08x", ptp->params[0]);
+		ptp_response(cam,PTP_RC_InvalidObjectHandle,0);
+		return 1;
+	}
+	offset = ptp->params[1];
+	if (offset > cur->stbuf.st_size) {
+		ptp_response(cam,PTP_RC_InvalidParameter,0);
+		return 1;
+	}
+	bytes = cur->stbuf.st_size - offset;
+	if (bytes > ptp->params[2])
+		bytes = ptp->params[2];
+	data = read_file(cur);
+	if (!data) {
+		ptp_response(cam,PTP_RC_GeneralError,0);
+		return 1;
+	}
+
+	ptp_senddata (cam, 0x101B, data + offset, bytes);
+	free (data);
+	ptp_response (cam, PTP_RC_OK, 1, bytes);
+	return 1;
+}
